generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  candidate
  interviewer
  ta_admin
}

enum InterviewerType {
  hr
  technical
  managerial
  screening
}

enum RoundType {
  screening
  technical
  managerial
  HR
}

enum AvailabilityOwnerType {
  candidate
  interviewer
}

enum AvailabilityStatus {
  available
  unavailable
  selected
  expired
}

enum ParticipantRole {
  primary
  secondary
  observer
}

enum JobStatus {
  draft
  open
  closed
}

enum ApplicationScreeningStatus {
  pending
  processing
  passed
  failed
}

enum ApplicationStatus {
  submitted
  screening
  shortlisted
  interviewing
  selected
  rejected
}

enum PipelineStageStatus {
  pending
  in_progress
  scheduled
  completed
  selected
  rejected
  no_show
  cancelled
}

enum InterviewStatus {
  pending
  interviewer_requested
  confirmed
  scheduled
  completed
  cancelled
  no_show
}

enum InterviewRequestStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

enum CalendarEventStatus {
  created
  updated
  cancelled
}

enum NotificationChannel {
  email
  in_app
  sms
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
}

enum ModelType {
  resume_screening
  interviewer_matching
  slot_recommendation
}

enum ModelRunStatus {
  processing
  completed
  failed
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  timezone        String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidateProfile   Candidate?      @relation("CandidateUser")
  interviewerProfile Interviewer?    @relation("InterviewerUser")
  oauthAccounts      OAuthAccount[]
  createdJobs        Job[]           @relation("JobCreator")
  decidedStages      PipelineStage[] @relation("StageDecider")
  auditLogs          AuditLog[]      @relation("AuditActor")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Candidate {
  id            String   @id @default(uuid())
  userId        String   @unique
  name          String
  email         String   @unique
  phone         String?
  resumeUrl     String?
  timezone      String
  currentStage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User               @relation("CandidateUser", fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]
  availability   AvailabilitySlot[] @relation("CandidateAvailability")
  calendarEvents CalendarEvent[]
}

model Interviewer {
  id              String         @id @default(uuid())
  userId          String         @unique
  name            String
  email           String         @unique
  jobRole         String
  interviewerType InterviewerType
  experienceYears Int
  timezone        String
  workingHours    Json?
  skills          String[]
  isAvailable     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user               User                  @relation("InterviewerUser", fields: [userId], references: [id], onDelete: Cascade)
  participants       InterviewParticipant[]
  availability       AvailabilitySlot[]   @relation("InterviewerAvailability")
  selectedInterviews Interview[]           @relation("SelectedInterviewer")
  matches            InterviewerMatch[]
  requests           InterviewRequest[]
  calendarEvents     CalendarEvent[]
}

model Job {
  id             String    @id @default(uuid())
  title          String
  description    String?
  department     String?
  location       String?
  experienceMin  Int?
  experienceMax  Int?
  requiredSkills String[]
  status         JobStatus @default(draft)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy    User          @relation("JobCreator", fields: [createdById], references: [id])
  applications Application[]
}

model Application {
  id              String                     @id @default(uuid())
  candidateId     String
  jobId           String
  resumeUrl       String?
  resumeScore     Decimal?
  screeningStatus ApplicationScreeningStatus @default(pending)
  status          ApplicationStatus          @default(submitted)
  appliedAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  candidate      Candidate       @relation(fields: [candidateId], references: [id])
  job            Job             @relation(fields: [jobId], references: [id])
  pipelineStages PipelineStage[]
  interviews     Interview[]
  modelRuns      ModelRun[]

  @@unique([candidateId, jobId])
}

model PipelineStage {
  id                   String              @id @default(uuid())
  applicationId        String
  roundType            RoundType
  stageOrder           Int
  status               PipelineStageStatus @default(pending)
  scheduledInterviewId String?
  feedbackNotes        String?
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  application        Application @relation(fields: [applicationId], references: [id])
  scheduledInterview Interview?   @relation("ScheduledPipelineStage", fields: [scheduledInterviewId], references: [id])
  decidedBy          User?        @relation("StageDecider", fields: [decidedById], references: [id])
  interview          Interview?   @relation("InterviewPipelineStage")

  @@unique([scheduledInterviewId])
  @@index([applicationId, stageOrder])
}

model Interview {
  id                    String          @id @default(uuid())
  applicationId         String
  pipelineStageId       String?         @unique
  roundType             RoundType
  durationMins          Int
  selectedInterviewerId String?
  status                InterviewStatus @default(pending)
  selectedSlot          DateTime?
  meetLink              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  application         Application           @relation(fields: [applicationId], references: [id])
  pipelineStage       PipelineStage?        @relation("InterviewPipelineStage", fields: [pipelineStageId], references: [id])
  scheduledStage      PipelineStage?        @relation("ScheduledPipelineStage")
  selectedInterviewer Interviewer?          @relation("SelectedInterviewer", fields: [selectedInterviewerId], references: [id])
  participants        InterviewParticipant[]
  availability        AvailabilitySlot[]
  matches             InterviewerMatch[]
  slotRecommendations SlotRecommendation[]
  requests            InterviewRequest[]
  calendarEvents      CalendarEvent[]
  notifications       NotificationLog[]
}

model InterviewParticipant {
  id              String          @id @default(uuid())
  interviewId     String
  interviewerId   String
  participantRole ParticipantRole
  isRequired      Boolean         @default(true)
  createdAt       DateTime        @default(now())

  interview   Interview   @relation(fields: [interviewId], references: [id])
  interviewer Interviewer @relation(fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
}

model AvailabilitySlot {
  id            String                @id @default(uuid())
  interviewId   String?
  ownerType     AvailabilityOwnerType
  candidateId   String?
  interviewerId String?
  startUtc      DateTime
  endUtc        DateTime
  status        AvailabilityStatus    @default(available)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  interview   Interview?   @relation(fields: [interviewId], references: [id])
  candidate   Candidate?   @relation("CandidateAvailability", fields: [candidateId], references: [id])
  interviewer Interviewer? @relation("InterviewerAvailability", fields: [interviewerId], references: [id])

  @@index([candidateId, startUtc, endUtc])
  @@index([interviewerId, startUtc, endUtc])
  @@index([interviewId, startUtc, endUtc])
}

model InterviewerMatch {
  id                   String     @id @default(uuid())
  interviewId          String
  interviewerId        String
  matchScore           Decimal?
  rank                 Int
  skillMatchScore      Decimal?
  experienceMatchScore Decimal?
  roleMatchScore       Decimal?
  reason               String?
  modelVersion         String?
  createdAt            DateTime   @default(now())

  interview   Interview   @relation(fields: [interviewId], references: [id])
  interviewer Interviewer @relation(fields: [interviewerId], references: [id])

  @@index([interviewId])
  @@index([interviewerId])
  @@index([interviewId, rank])
}

model SlotRecommendation {
  id                       String   @id @default(uuid())
  interviewId              String
  slot                     DateTime
  priorityScore            Decimal?
  rank                     Int
  workingHoursScore        Decimal?
  bufferBeforeScore        Decimal?
  bufferAfterScore         Decimal?
  candidatePreferenceScore Decimal?
  reason                   String?
  modelVersion             String?
  createdAt                DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id])

  @@index([interviewId])
  @@index([interviewId, rank])
}

model InterviewRequest {
  id            String                 @id @default(uuid())
  interviewId   String
  interviewerId String
  slot          DateTime
  status        InterviewRequestStatus @default(pending)
  sentAt        DateTime               @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime?

  interview   Interview   @relation(fields: [interviewId], references: [id])
  interviewer Interviewer @relation(fields: [interviewerId], references: [id])

  @@index([interviewId])
  @@index([interviewerId])
  @@index([status])
}

model CalendarEvent {
  id              String              @id @default(uuid())
  interviewId     String
  interviewerId   String
  candidateId     String
  slot            DateTime
  externalEventId String?
  meetLink        String?
  status          CalendarEventStatus @default(created)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  interview   Interview   @relation(fields: [interviewId], references: [id])
  interviewer Interviewer @relation(fields: [interviewerId], references: [id])
  candidate   Candidate   @relation(fields: [candidateId], references: [id])

  @@index([slot])
}

model NotificationLog {
  id            String             @id @default(uuid())
  interviewId   String?
  recipientType String
  recipientId   String
  channel       NotificationChannel
  type          String
  status        NotificationStatus @default(pending)
  message       String?
  readAt        DateTime?
  timestamp     DateTime           @default(now())

  interview Interview? @relation(fields: [interviewId], references: [id])

  @@index([recipientType, recipientId])
  @@index([interviewId])
}

model ModelRun {
  id               String         @id @default(uuid())
  modelType        ModelType
  modelVersion     String
  inputReferenceId String
  inputData        Json?
  outputData       Json?
  status           ModelRunStatus @default(processing)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?
  applicationId    String?

  application Application? @relation(fields: [applicationId], references: [id])

  @@index([modelType, inputReferenceId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
