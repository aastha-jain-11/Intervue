# Frontend
VITE_API_BASE_URL=http://localhost:3000

# Node API
NODE_ENV=development
PORT=3000

# PostgreSQL / Neon
DATABASE_URL=your-neon-database-url

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend CORS
CORS_ORIGIN=http://localhost:5173

# Internal Python services
RESUME_SERVICE_URL=http://localhost:8001
RESUME_SERVICE_TOKEN=replace-with-a-random-internal-service-token

NOTIFICATION_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_TOKEN=replace-with-a-random-internal-service-token

# Internal service timeouts
RESUME_SERVICE_SCREENING_TIMEOUT_MS=30000
RESUME_SERVICE_COMPUTE_TIMEOUT_MS=10000
NOTIFICATION_SERVICE_TIMEOUT_MS=10000